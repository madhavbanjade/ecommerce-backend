// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum Size {
  sm
  md
  lg
  xl
  xxl
  xxxl
  xl4
}

enum Gender {
  Male
  Female
  Unisex
}

enum OrderStatus {
  Pending
  Confirmed
  Shipped
  Delivered
  Cancelled
    Returned
  ReturnRequested
}

//users schema
model User {
  id String @id @default(uuid())

  email     String    @unique
  username  String    @unique
  password  String
  role      Role      @default(user)
  reviews   Review[]
  wishlist  Product[] @relation("UserWishlist")
  cart      Cart[]
  order     Order[]
  createdAt DateTime  @default(now())
}

//product schema 
model Product {
  id              String        @id @default(uuid())
  images          String[]
  name            String        @unique
  slug            String        @unique
  description     String
  gender          Gender
  category        Category[]
  originalPrice   Int
  discountPercent Float?
  dicountPrice    Float?
  tag             String
  sizes           ProductSize[]
  isAvilable      Boolean       @default(true)
  reviews         Review[]
  wishlistBy      User[]        @relation("UserWishlist")
  cart            Cart[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ProductSize {
  id            String  @id @default(uuid())
  productId     String
  size          Size
  stockQuantity Int
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
}

model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

//review schema 
model Review {
  id        String   @id @default(uuid())
  productId String
  UserId    String
  rating    Int
  title     String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [UserId], references: [id], onDelete: Cascade)
}

//cart schema 
model Cart {
  id        String   @id @default(uuid())
  productId String
  userId    String
  size      Size
  quantity  Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId, size])
}

//order item 
model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  size      Size
  unitPrice Int
  quantity  Int
  totalPrice Int
  image     String
}

//order 
model Order {
  id     String @id @default(uuid())
  userId String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  OrderStatus  @default(Pending)
  totalPrice Int
  items   OrderItem[]
  createdAt  DateTime @default(now())
}
